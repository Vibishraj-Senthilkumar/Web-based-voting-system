# Auto detect text files and normalize to LF
* text=auto eol=lf

# Windows batch files use CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Shell scripts and wrapper files use LF
*.sh text eol=lf
/mvnw text eol=lf

# Java / Spring Boot
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf

# Node / React
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
